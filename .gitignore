# Rust / Cargo 编译产物（根目录 + 子工程）
# target* 同时覆盖 cargo 并发时生成的临时目录（如 targetkn1wPx）
**/target*
*.rs.bk

# 环境与本地配置（含密钥，不入库）
.env
.env.*
!.env.example
config.local.toml

# 日志
*.log

# macOS
.DS_Store

# IDE / 编辑器
.idea/
.vscode/
*.iml
*.swp
*.swo

# 运行时产物（文件上传 / 临时文件）
uploads/
tmp/
backups/

# 工具生成目录（不入库）
graphify-out/
src/graphify-out/
.graphify-out/
.codex/skills/
.zcode/
.agents/skills/
.opencode/skills/
.trae/skills/
.claude/skills/
.codebuddy/skills/

# 项目工作记忆（不入库）
.workbuddy/

# 本地设计文档 / 工作文档（不入库，仅本地协作用）
docs/
