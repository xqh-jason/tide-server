{
  "domain": "operation_log",
  "group": "system",
  "table": "sys_operation_log",
  "comment": "操作日志",
  "fields": [
    {
      "name": "id",
      "rust_type": "u64",
      "primary": true,
      "auto_increment": true
    },
    {
      "name": "user_id",
      "rust_type": "u64",
      "optional": false,
      "comment": "操作人 ID"
    },
    {
      "name": "ip",
      "rust_type": "String",
      "optional": true,
      "default": "",
      "comment": "来源 IP"
    },
    {
      "name": "method",
      "rust_type": "String",
      "optional": true,
      "default": "",
      "comment": "请求方法"
    },
    {
      "name": "path",
      "rust_type": "String",
      "optional": false,
      "comment": "请求路径"
    },
    {
      "name": "status",
      "rust_type": "i32",
      "optional": true,
      "default": 0,
      "comment": "HTTP 状态码"
    },
    {
      "name": "latency",
      "rust_type": "i64",
      "optional": true,
      "default": 0,
      "comment": "请求耗时（毫秒）"
    },
    {
      "name": "agent",
      "rust_type": "String",
      "optional": true,
      "default": "",
      "comment": "User-Agent"
    },
    {
      "name": "body",
      "rust_type": "String",
      "optional": true,
      "default": "",
      "comment": "请求体（脱敏截断后）"
    },
    {
      "name": "resp",
      "rust_type": "String",
      "optional": true,
      "default": "",
      "comment": "响应体（脱敏截断后）"
    },
    {
      "name": "error_message",
      "rust_type": "String",
      "optional": true,
      "default": "",
      "comment": "失败提示"
    },
    {
      "name": "created_at",
      "rust_type": "DateTime",
      "readonly": true
    },
    {
      "name": "deleted_at",
      "rust_type": "Option<DateTime>",
      "readonly": true
    }
  ],
  "unique_fields": [],
  "filters": [
    {
      "field": "user_id",
      "kind": "exact"
    },
    {
      "field": "status",
      "kind": "exact"
    }
  ]
}
