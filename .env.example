# 复制为 .env 后 docker compose 自动读取（.env 已被 .gitignore 排除，勿提交真实密钥）

# MySQL root 密码（mysql 服务与后端连接串共用）
MYSQL_ROOT_PASSWORD=root

# JWT 签名密钥（必设；生产替换为强随机串。production 下默认开发密钥会被
# 后端拒绝启动，未设置时 compose 也会直接报错）
TIDE_JWT_SECRET=dev-secret-change-me

# 首次部署 bootstrap：置 true 启动 backend 一次，创建初始 admin/super 角色；
# 完成后改回 false 并重新 `docker compose up -d`（并立即修改 admin 密码）
# TIDE_SEED_ENABLED=false

# 前端仓库目录（相对于 docker-compose.yml）。默认 ../tide-admin = 基座自带前端；
# 派生业务仓（如 tide-hr-admin）时改成你自己的目录，见 README「作为基座」一节。
# FRONTEND_DIR=../tide-admin
